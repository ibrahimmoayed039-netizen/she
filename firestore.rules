rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isStaff() {
      return request.auth != null && exists(/databases/$(db)/documents/staff/$(request.auth.uid));
    }
    function myDepts() {
      let s = get(/databases/$(db)/documents/staff/$(request.auth.uid)).data;
      return ('departments' in s) ? s.departments : [s.department];
    }
    match /staff/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    match /complaints/{id} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.department == '';
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || (isStaff() && resource.data.department in myDepts()));
      // الموظف: الحالة والرد والتقرير والكادر وصورة ما بعد الصيانة
      allow update: if isStaff() && resource.data.department in myDepts()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reply', 'updatedAt', 'branch', 'repairable', 'materials', 'assessedAt', 'crew', 'crewAt', 'afterImageB64', 'afterAt', 'startedAt', 'resolvedAt']);
      // المواطن: تقييم شكواه مرة واحدة بعد «تم الحل»
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'resolved'
        && !('rating' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'ratedAt'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;

      // سجل الشكوى
      match /log/{lid} {
        allow read: if isStaff() && get(/databases/$(db)/documents/complaints/$(id)).data.department in myDepts();
        allow create: if isStaff()
          && get(/databases/$(db)/documents/complaints/$(id)).data.department in myDepts()
          && request.resource.data.keys().hasOnly(['by', 'action', 'at']);
      }
    }
  }
}
