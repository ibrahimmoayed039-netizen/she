rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isStaff() {
      return request.auth != null && exists(/databases/$(db)/documents/staff/$(request.auth.uid));
    }
    function myDepts() {
      let s = get(/databases/$(db)/documents/staff/$(request.auth.uid)).data;
      return ('departments' in s) ? s.departments : [s.department];
    }
    match /staff/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    match /complaints/{id} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.department == '';
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || (isStaff() && resource.data.department in myDepts()));
      allow update: if isStaff() && resource.data.department in myDepts()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reply', 'updatedAt', 'seenAt', 'startedAt', 'resolvedAt', 'handledBy']);
    }
  }
}
