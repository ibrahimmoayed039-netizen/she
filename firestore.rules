rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isStaff() {
      return request.auth != null && exists(/databases/$(db)/documents/staff/$(request.auth.uid))
        && get(/databases/$(db)/documents/staff/$(request.auth.uid)).data.get('disabled', false) != true;
    }
    function sdata() {
      return get(/databases/$(db)/documents/staff/$(request.auth.uid)).data;
    }
    // حساب كادر ميداني: staff/{uid} فيه role = 'crew' والحقل crew باسم الكادر
    function isCrew() { return isStaff() && sdata().get('role', '') == 'crew'; }
    function isDeptStaff() { return isStaff() && sdata().get('role', '') != 'crew'; }
    function myCrew() { return sdata().get('crew', ''); }
    function myDepts() {
      let s = sdata();
      return ('departments' in s) ? s.departments : [s.department];
    }
    // هل يحق لهذا الموظف/الكادر رؤية الشكوى (بيانات الشكوى c)
    function canSee(c) {
      return c.department in myDepts()
        && (isDeptStaff() || (isCrew() && myCrew() != '' && c.crew == myCrew()));
    }

    // قائمة الأقسام (أنواع الشكاوى) التي يختار منها المواطن؛ يكتبها برنامج الحاسوب فقط
    match /config/{d} {
      allow read: if request.auth != null;
    }
    // كوادر الأقسام التي يضيفها المدير من برنامج الحاسوب (قراءة فقط للموظفين)
    match /deptCrews/{d} {
      allow read: if isStaff();
    }
    match /staff/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    match /complaints/{id} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.department == '';
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || (isStaff() && canSee(resource.data)));
      // موظف القسم: الحالة والرد والتقرير والكادر وصورة ما بعد الصيانة
      allow update: if isDeptStaff() && resource.data.department in myDepts()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reply', 'updatedAt', 'branch', 'repairable', 'materials', 'assessedAt', 'crew', 'crewAt', 'afterImageB64', 'afterAt', 'startedAt', 'resolvedAt', 'arrivedAt', 'materialsReady', 'materialsReadyAt', 'materialsStatus', 'materialsNote', 'submittedAt', 'approvedAt', 'returnNote', 'returnedAt', 'blockedReason', 'blockedBy', 'blockedAt']);
      // الكادر الميداني: شكاواه المُسندة إليه فقط، ولا يستطيع تغيير الكادر
      // (v33) الكادر لا يستطيع إنهاء الشكوى: يرسل الإنجاز «بانتظار اعتماد القسم» (pending_review) فقط
      allow update: if isCrew() && canSee(resource.data)
        && request.resource.data.status in ['routed', 'in_progress', 'pending_review']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reply', 'updatedAt', 'branch', 'repairable', 'materials', 'assessedAt', 'afterImageB64', 'afterAt', 'startedAt', 'resolvedAt', 'arrivedAt', 'submittedAt', 'returnNote', 'materialsStatus', 'materialsReceivedAt'])
        && (!('returnNote' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.returnNote == '')
        && (!('materialsStatus' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.materialsStatus == 'received');
      // (v33) «تعذّر العمل»: يُخلي الكادر الشكوى ويعيدها للقسم مع السبب
      allow update: if isCrew() && canSee(resource.data)
        && request.resource.data.status == 'routed'
        && request.resource.data.get('crew', '') == ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'crew', 'blockedReason', 'blockedBy', 'blockedAt', 'arrivedAt', 'updatedAt']);
      // المواطن: تقييم شكواه مرة واحدة بعد «تم الحل»
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'resolved'
        && !('rating' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'ratedAt'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;

      // المواطن: تأكيد أن المشكلة حُلّت (مرة واحدة)
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'resolved'
        && !('confirmed' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmed', 'confirmedAt'])
        && request.resource.data.confirmed == true;
      // المواطن: إعادة فتح شكوى لم تُحل فعلاً (حتى 3 مرات) فتعود للقسم
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'resolved'
        && !('confirmed' in resource.data)
        && request.resource.data.status == 'routed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reopenCount', 'reopenedAt', 'reopenReason', 'arrivedAt', 'updatedAt'])
        && request.resource.data.reopenCount == resource.data.get('reopenCount', 0) + 1
        && request.resource.data.reopenCount <= 3
        && request.resource.data.reopenReason.size() <= 300;

      // سجل الشكوى
      match /log/{lid} {
        allow read: if isStaff() && canSee(get(/databases/$(db)/documents/complaints/$(id)).data);
        allow create: if isStaff()
          && canSee(get(/databases/$(db)/documents/complaints/$(id)).data)
          && request.resource.data.keys().hasOnly(['by', 'action', 'at']);
      }
    }
  }
}
